rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /resumes/{resumeId} {
      // Allow creation for authenticated users or link sessions
      allow create: if true;
      
      // Allow read if resume link is shareable (isPublicEdit is not explicitly false), user is owner, or listed editor
      allow read: if resource.data.get('isPublicEdit', true) != false || 
                  (request.auth != null && (
                    resource.data.userId == request.auth.uid || 
                    (resource.data.allowedEditors != null && request.auth.token.email in resource.data.allowedEditors) ||
                    (resource.data.allowedEditors != null && request.auth.uid in resource.data.allowedEditors)
                  ));

      // Allow update if resume link is shareable (isPublicEdit is not explicitly false), user is owner, or listed editor
      allow update: if resource.data.get('isPublicEdit', true) != false || 
                    (request.auth != null && (
                      resource.data.userId == request.auth.uid || 
                      (resource.data.allowedEditors != null && request.auth.token.email in resource.data.allowedEditors) ||
                      (resource.data.allowedEditors != null && request.auth.uid in resource.data.allowedEditors)
                    ));

      // Allow delete only for the resume owner
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}



